# ---------------------------------------------------------------------------
# VetLink — Supabase configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# Only the anon (public) key belongs in the mobile app. Never put the
# service_role key in an EXPO_PUBLIC_* variable — it bypasses Row Level Security.
#
# Restart `npx expo start` after changing these values.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — MapTiler key for the clinic map (free plan: cloud.maptiler.com).
# Leave empty to use OpenStreetMap's free tiles. This key is public by design;
# restrict it to your domains in the MapTiler dashboard.
EXPO_PUBLIC_MAPTILER_KEY=
